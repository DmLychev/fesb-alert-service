# Compose / PostgreSQL
DB_NAME=fesb_alert
DB_USER=fesb_alert
DB_PASS=replace-with-a-long-random-password

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=alerts.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://alerts.example.com
DJANGO_ACCESS_TOKEN_LIFETIME_MINUTES=30
DJANGO_REFRESH_TOKEN_LIFETIME_DAYS=7
WEBSOCKET_TICKET_TTL_SECONDS=30

# Keep/change this only if the worker really needs your corporate DNS resolver.
WORKER_DNS=10.152.1.5
