# PostgreSQL
DB_NAME=fesb_alert_service
DB_USER=fesb_alert_service
DB_PASS=replace-with-a-long-random-password

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=alerts.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://alerts.example.com
DJANGO_ACCESS_TOKEN_LIFETIME_MINUTES=30
DJANGO_REFRESH_TOKEN_LIFETIME_DAYS=7
WEBSOCKET_TICKET_TTL_SECONDS=30

# Worker
FESB_API_USER=service_user
FESB_API_PASSWORD=service_user_password
FESB_HOST=http://example.com
FESB_PORT=80
FESB_MESSAGE_LOG_ENDPOINT=/message_log
FESB_MESSAGE_ERROR_DETAILS_ENDPOINT=/message_log/status
FESB_TREAT_HTTP_AS_SECURE=false

SMTP_SENDER_EMAIL='noreply_SAP@binnopharmgroup.ru'
SMTP_SERVER='mail.example.com'
SMTP_PORT=587
SMTP_PASSWORD=exchange_user_password
